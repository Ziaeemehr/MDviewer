{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Viewer",
  "version": "0.5.0",
  "identifier": "io.github.ziaeemehr.mdviewer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MD Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Markdown viewer for Persian/English text with LaTeX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "mdviewer.desktop"
      },
      "rpm": {
        "desktopTemplate": "mdviewer.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1ODMyQzlCMzNGQjIzQzcKUldUSEkvc3pteXlEQlVCMTUvTzcyb3BTdVNYK2ZYSVRQYTNIYWsvL0QrV092dFJVQ25lZU1hemkK",
      "endpoints": [
        "https://github.com/Ziaeemehr/MDviewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
